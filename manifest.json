{
  "manifest_version": 3,
  "name": "ATN Review Analyzer",
  "version": "0.1.0",
  "description": "Collects the entries of the add-on review log into a local database and shows statistics.",
  "author": "John Bieling",
  "browser_specific_settings": {
    "gecko": {
      "id": "atn-reviewer-analyzer@john.bieling",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://addons.thunderbird.net/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://addons.thunderbird.net/*/reviewers/reviewlog*"],
      "js": ["lib/parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ATN Review Analyzer",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
